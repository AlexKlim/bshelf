<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title><%= t("oauth.title") %></title>
  <style>
    body { font: 16px/1.5 system-ui, sans-serif; margin: 0; padding: 24px 16px; color: #1f1d1a; background: #faf8f5; }
    main { max-width: 420px; margin: 0 auto; }
    h1 { font-size: 22px; margin: 0 0 16px; }
    button { width: 100%; font: inherit; padding: 12px; margin-top: 12px; border-radius: 8px; border: 1px solid #1f1d1a; }
    .allow { background: #1f1d1a; color: #fff; }
    .deny { background: transparent; color: #1f1d1a; }
    .muted { color: #6b665e; font-size: 14px; }
    @media (prefers-color-scheme: dark) {
      body { color: #eee9e1; background: #1a1917; }
      button { border-color: #eee9e1; }
      .allow { background: #eee9e1; color: #1a1917; }
      .deny { color: #eee9e1; }
      .muted { color: #a59f95; }
    }
  </style>
</head>
<body>
  <main><%= yield %></main>
</body>
</html>
