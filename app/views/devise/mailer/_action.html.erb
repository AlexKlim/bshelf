<h1 style="margin: 0 0 12px; font: 600 24px/32px Georgia, 'Times New Roman', serif; color: #1e231f;"><%= title %></h1>
<p style="margin: 0 0 28px; color: #535b54;"><%= lead %></p>
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="border-radius: 6px; background: #606b5b;">
<a href="<%= url %>" style="display: inline-block; padding: 12px 24px; font: 500 16px/20px -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #ffffff; text-decoration: none; border-radius: 6px;"><%= button %></a>
</td></tr></table>
<p style="margin: 28px 0 0; font-size: 13px; line-height: 18px; color: #535b54;"><%= t("mailer.fallback") %><br><a href="<%= url %>" style="color: #4c5648; word-break: break-all;"><%= url %></a></p>
<% if local_assigns[:note] %>
<p style="margin: 20px 0 0; font-size: 13px; line-height: 18px; color: #535b54;"><%= note %></p>
<% end %>
